# VPS-only. Never commit real values.
# Cloudflare R2 — Layer-3 offsite backup (free tier: 10 GB storage).
#
# Create: Dashboard → R2 → bucket (dedicated, e.g. infra-backups)
# API token: R2 → Manage R2 API Tokens → Object Read & Write (this bucket only)
#
# Guardrails (scripts/backup/r2-upload.sh):
#   R2_KEEP_LAST=3              keep 3 remote backup sets (~150 MB with ~50 MB tars)
#   R2_SOFT_MAX_BYTES=8589934592  skip upload if projected usage > 8 GiB (80% of 10 GB)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=infra-backups
R2_KEEP_LAST=3
R2_SOFT_MAX_BYTES=8589934592
