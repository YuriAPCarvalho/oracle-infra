# Secrets only on the VPS — never commit real values.
# DATABASE_URL uses hostname "postgres" on the Docker internal network.

SERVICE_NAME=dailybot
SERVICE_IMAGE=dailybot:local

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
CHANNEL_DAILY=
CHANNEL_PO=
CHANNEL_ANIVERSARIOS=

TIMEZONE=America/Campo_Grande
DAILY_DEV_HOUR=08:00
DAILY_PO_HOUR=08:15
ALERT_HOUR=08:40
FORM_DEADLINE_HOUR=09:00
BIRTHDAY_HOUR=09:30

DATABASE_URL=postgresql://dailybot:CHANGE_ME@postgres:5432/dailybot

GLPI_URL=https://suporte.ms.gov.br
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_DOMAIN=
GLPI_CHECK_INTERVAL_MINUTES=5
GLPI_HEADLESS=true
GLPI_NOTIFY_EXISTING_ON_FIRST_RUN=false
GLPI_GRUPO_TECNICO=
GLPI_SAVED_SEARCH_ID=
CHANNEL_GLPI_NOTIFICACOES=

# Optional Uptime Kuma Push (proxy network)
# KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/<token>
