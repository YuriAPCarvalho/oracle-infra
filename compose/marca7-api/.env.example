# VPS-only. Never commit real values.
# Copy to /opt/infra/compose/marca7-api/.env

SERVICE_IMAGE=ghcr.io/marca7-tech/marca7-gestor-agro-api:latest
SERVICE_HOST=gestoragro-api.marca7.tech

PORT=4000
DATABASE_URL=postgresql://marca7:CHANGE_ME@postgres:5432/marca7
FRONTEND_URL=https://gestoragro.marca7.tech
TOKEN_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=https://s3.marca7.tech
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
BUCKET=marca7-estoque

NODE_ENV=production

# Seed admin (prisma/seed.ts on container start):
# CPF: 00000000000
# Senha: admin123 — trocar após o primeiro login
