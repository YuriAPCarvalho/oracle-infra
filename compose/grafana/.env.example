# Copy to compose/grafana/.env on the VPS only. Never commit real values.
#
# Required:
# GF_SECURITY_ADMIN_USER=
# GF_SECURITY_ADMIN_PASSWORD=
#
# Public host (Traefik + Cloudflare Access), same pattern as other panels:
SERVICE_HOST=grafana.chamaeu.app
#
# Optional Discord alerting — same #infra-alertas channel as Uptime Kuma is fine.
# Seed on VPS: bash scripts/grafana-seed-discord.sh --test
# (copies KUMA_DISCORD_WEBHOOK_URL if this is empty). Never reuse CI webhook.
# GRAFANA_DISCORD_WEBHOOK_URL=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
# GRAFANA_DISCORD_WEBHOOK_URL=
