{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"traefik\"}", "refId": "A" }],
      "title": "Traefik scrape",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{entrypoint=~\"web|websecure\"}[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Entrypoint requests by status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "targets": [
        {
          "expr": "topk(10, sum by (router) (rate(traefik_router_requests_total[5m])))",
          "legendFormat": "{{router}}",
          "refId": "A"
        }
      ],
      "title": "Top routers (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(traefik_router_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traefik_router_requests_total{code=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "B"
        }
      ],
      "title": "HTTP errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, entrypoint) (rate(traefik_entrypoint_request_duration_seconds_bucket{entrypoint=~\"web|websecure\"}[5m])))",
          "legendFormat": "p95 {{entrypoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, entrypoint) (rate(traefik_entrypoint_request_duration_seconds_bucket{entrypoint=~\"web|websecure\"}[5m])))",
          "legendFormat": "p50 {{entrypoint}}",
          "refId": "B"
        }
      ],
      "title": "Entrypoint latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(traefik_entrypoint_requests_bytes_total{entrypoint=~\"web|websecure\"}[5m]))",
          "legendFormat": "request bytes/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(traefik_entrypoint_responses_bytes_total{entrypoint=~\"web|websecure\"}[5m]))",
          "legendFormat": "response bytes/s",
          "refId": "B"
        }
      ],
      "title": "Entrypoint bytes",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["oracle-infra", "traefik", "edge"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Edge (Traefik)",
  "uid": "oracle-edge-traefik",
  "version": 1
}
