{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"minio\"}", "refId": "A" }],
      "title": "MinIO scrape",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "targets": [
        { "expr": "minio_cluster_capacity_usable_total_bytes", "legendFormat": "usable total", "refId": "A" },
        { "expr": "minio_cluster_capacity_usable_free_bytes", "legendFormat": "usable free", "refId": "B" }
      ],
      "title": "Cluster capacity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "targets": [
        { "expr": "minio_cluster_nodes_online_total", "legendFormat": "nodes online", "refId": "A" },
        { "expr": "minio_cluster_drive_online_total", "legendFormat": "drives online", "refId": "B" },
        { "expr": "minio_bucket_usage_object_total", "legendFormat": "objects {{bucket}}", "refId": "C" }
      ],
      "title": "Nodes / drives / objects",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "targets": [
        { "expr": "rate(minio_s3_traffic_received_bytes[5m])", "legendFormat": "rx", "refId": "A" },
        { "expr": "rate(minio_s3_traffic_sent_bytes[5m])", "legendFormat": "tx", "refId": "B" }
      ],
      "title": "S3 traffic",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 5,
      "targets": [
        { "expr": "rate(minio_s3_requests_total[5m])", "legendFormat": "{{api}} {{bucket}}", "refId": "A" }
      ],
      "title": "S3 requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "id": 6,
      "targets": [
        { "expr": "minio_bucket_usage_total_bytes", "legendFormat": "{{bucket}}", "refId": "A" }
      ],
      "title": "Bucket usage",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["oracle-infra", "minio", "storage"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MinIO",
  "uid": "oracle-minio",
  "version": 1
}
