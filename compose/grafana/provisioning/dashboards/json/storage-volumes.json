{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"})",
          "legendFormat": "boot /",
          "refId": "A"
        }
      ],
      "title": "Boot Volume usage %",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/opt/docker\"} * 100) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/opt/docker\"})",
          "legendFormat": "/opt/docker",
          "refId": "A"
        }
      ],
      "title": "Block Volume usage %",
      "description": "No data until /opt/docker is a separate mount (or bind). Same as boot if still single disk.",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"}",
          "legendFormat": "boot free",
          "refId": "A"
        }
      ],
      "title": "Boot free bytes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/opt/docker\"}",
          "legendFormat": "data free",
          "refId": "A"
        }
      ],
      "title": "Block free bytes",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "targets": [
        {
          "expr": "infra_storage_dir_bytes{path=~\"databases/postgres|databases/redis\"}",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "title": "Database directory growth",
      "description": "Requires scripts/metrics/storage-textfile.sh on cron.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "targets": [
        {
          "expr": "infra_storage_dir_bytes{path=\"object-storage/minio\"}",
          "legendFormat": "minio data",
          "refId": "A"
        },
        {
          "expr": "minio_cluster_capacity_usable_free_bytes",
          "legendFormat": "minio usable free",
          "refId": "B"
        }
      ],
      "title": "MinIO / buckets growth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "targets": [
        {
          "expr": "infra_storage_dir_bytes{path=~\"backups|backups/full|backups/postgres\"}",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "title": "Backups growth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "custom": { "fillOpacity": 0, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "targets": [
        {
          "expr": "infra_backup_last_success_timestamp_seconds * 1000",
          "legendFormat": "last success",
          "refId": "A"
        }
      ],
      "title": "Last Layer-1 backup success",
      "description": "From .last-success marker via textfile collector.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "custom": { "fillOpacity": 0, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "targets": [
        {
          "expr": "infra_r2_last_success_timestamp_seconds * 1000",
          "legendFormat": "last R2 success",
          "refId": "A"
        }
      ],
      "title": "Last Layer-3 R2 backup success",
      "description": "From backups/full/.last-r2-success via storage-textfile.sh.",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "soft max" },
            "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 22 },
      "id": 10,
      "targets": [
        {
          "expr": "infra_r2_bucket_bytes",
          "legendFormat": "bucket bytes",
          "refId": "A"
        },
        {
          "expr": "infra_r2_soft_max_bytes",
          "legendFormat": "soft max",
          "refId": "B"
        }
      ],
      "title": "R2 usage vs soft cap",
      "description": "Approximate size under full/ prefix. Soft max defaults to 8 GiB (free tier 10 GiB).",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 22 },
      "id": 11,
      "targets": [
        {
          "expr": "infra_r2_object_count",
          "legendFormat": "objects",
          "refId": "A"
        }
      ],
      "title": "R2 object count",
      "description": "Approx objects under full/ (3 files per backup set).",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["oracle-infra", "storage"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Storage volumes",
  "uid": "storage-volumes",
  "version": 1
}
