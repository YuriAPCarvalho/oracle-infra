{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "CPU busy",
          "refId": "A"
        }
      ],
      "title": "CPU busy",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "node_load1", "legendFormat": "load1", "refId": "A" },
        { "expr": "node_load5", "legendFormat": "load5", "refId": "B" },
        { "expr": "node_load15", "legendFormat": "load15", "refId": "C" }
      ],
      "title": "Load average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Breaks busy CPU into modes — iowait = disk wait; steal = hypervisor contention.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 40, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 10,
      "targets": [
        {
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode=~\"user|system|iowait|steal|softirq|irq|nice\"}[5m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "CPU by mode",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "PSI: share of time some tasks waited on CPU / memory / IO.",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 11,
      "targets": [
        {
          "expr": "rate(node_pressure_cpu_waiting_seconds_total[5m])",
          "legendFormat": "cpu waiting",
          "refId": "A"
        },
        {
          "expr": "rate(node_pressure_memory_waiting_seconds_total[5m])",
          "legendFormat": "memory waiting",
          "refId": "B"
        },
        {
          "expr": "rate(node_pressure_io_waiting_seconds_total[5m])",
          "legendFormat": "io waiting",
          "refId": "C"
        },
        {
          "expr": "rate(node_pressure_io_stalled_seconds_total[5m])",
          "legendFormat": "io stalled",
          "refId": "D"
        }
      ],
      "title": "Host pressure (PSI)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 3,
      "targets": [
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "refId": "A" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "refId": "B" },
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "C" }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 4,
      "targets": [
        { "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "swap used", "refId": "A" },
        { "expr": "node_memory_SwapTotal_bytes", "legendFormat": "swap total", "refId": "B" }
      ],
      "title": "Swap",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 5,
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"} * 100) / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"})",
          "legendFormat": "root used %",
          "refId": "A"
        }
      ],
      "title": "Root filesystem usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 6,
      "targets": [
        {
          "expr": "100 - ((node_filesystem_files_free{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"} * 100) / clamp_min(node_filesystem_files{fstype!~\"tmpfs|overlay|squashfs\",mountpoint=\"/\"}, 1))",
          "legendFormat": "inodes used %",
          "refId": "A"
        }
      ],
      "title": "Root inode usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Fraction of time the disk was busy (util%). Near 100% = saturated.",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 12,
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{device!~\"loop.*|dm-.*|sr.*\"}[5m])",
          "legendFormat": "util {{device}}",
          "refId": "A"
        }
      ],
      "title": "Disk utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Average wait per I/O (seconds). Rising await with load = storage bottleneck.",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 13,
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{device!~\"loop.*|dm-.*|sr.*\"}[5m]) / clamp_min(rate(node_disk_reads_completed_total{device!~\"loop.*|dm-.*|sr.*\"}[5m]) + rate(node_disk_writes_completed_total{device!~\"loop.*|dm-.*|sr.*\"}[5m]), 1e-9)",
          "legendFormat": "await {{device}}",
          "refId": "A"
        }
      ],
      "title": "Disk await",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 7,
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m])", "legendFormat": "rx {{device}}", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}[5m])", "legendFormat": "tx {{device}}", "refId": "B" }
      ],
      "title": "Network throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Open FDs / sockets / TCP / conntrack — early warning for connection leaks.",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "conntrack %" },
            "properties": [{ "id": "unit", "value": "percentunit" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 14,
      "targets": [
        { "expr": "node_filefd_allocated", "legendFormat": "file descriptors", "refId": "A" },
        { "expr": "node_sockstat_sockets_used", "legendFormat": "sockets used", "refId": "B" },
        { "expr": "node_sockstat_TCP_alloc", "legendFormat": "TCP alloc", "refId": "C" },
        { "expr": "node_netstat_Tcp_CurrEstab", "legendFormat": "TCP established", "refId": "D" },
        {
          "expr": "node_nf_conntrack_entries / clamp_min(node_nf_conntrack_entries_limit, 1)",
          "legendFormat": "conntrack %",
          "refId": "E"
        }
      ],
      "title": "File descriptors & sockets",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "id": 8,
      "targets": [
        { "expr": "time() - node_boot_time_seconds", "legendFormat": "uptime", "refId": "A" }
      ],
      "title": "Host uptime",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "id": 9,
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total{device!~\"loop.*|dm-.*|sr.*\"}[5m])", "legendFormat": "read {{device}}", "refId": "A" },
        { "expr": "rate(node_disk_written_bytes_total{device!~\"loop.*|dm-.*|sr.*\"}[5m])", "legendFormat": "write {{device}}", "refId": "B" }
      ],
      "title": "Disk I/O",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["oracle-infra", "host", "node-exporter"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Host metrics",
  "uid": "oracle-host-metrics",
  "version": 2
}
