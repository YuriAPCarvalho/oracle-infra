# Runtime image for Gestor Agro APP.
# Must be a mutable tag (:latest or :main) so Watchtower can pull updates.
# Do NOT pin sha-* here for day-to-day — use sha-* only for manual rollback.
SERVICE_IMAGE=ghcr.io/marca7-tech/marca7-gestor-agro-app:latest
SERVICE_HOST=gestoragro.marca7.tech
# NEXT_PUBLIC_* are build-time (Docker ARG). CI must bake:
# NEXT_PUBLIC_ROUTE_URL=https://gestoragro-api.marca7.tech
# NEXT_PUBLIC_DOMAIN=.marca7.tech
