# Secrets reais ficam somente na VPS (.env) — nunca commitados.
# Copiar para /opt/infra/compose/bot-ponto/.env na implantação.

SERVICE_NAME=bot-ponto
SERVICE_IMAGE=bot-ponto:local

CENTRAL_URL=
CENTRAL_NUMERO_FOLHA=
CENTRAL_PASSWORD=
ALLOW_FINAL_CLICK=false
BOT_DISCORD_WEBHOOK=
