# Bot de ponto — referência de variáveis (sem valores reais)
# Documento alinhado à Discovery. Compose definitivo ainda não criado.

# --- Aplicação (repo secullum-web-automate) ---
# CENTRAL_URL=
# CENTRAL_NUMERO_FOLHA=
# CENTRAL_PASSWORD=
# HEADLESS=true
# TIMEZONE=America/Campo_Grande
# ALLOW_FINAL_CLICK=false
# BROWSER_STATE_PATH=/opt/docker/bot-ponto/browser-state/storageState.json
# EXECUTIONS_STATE_PATH=/opt/docker/bot-ponto/state/executions.json
# CONFIG_PATH=/app/config.json
# BROWSER_HOLD_SECONDS=0
# GEOLOCATION_LATITUDE=
# GEOLOCATION_LONGITUDE=
# GEOLOCATION_RADIUS_METERS=10

# Webhook funcional do bot (NÃO usar o webhook do CI/CD)
# BOT_DISCORD_WEBHOOK=
# (no app atual o nome ainda pode ser WEBHOOK_DISCORD_URL — renomear na implementação)

# --- Pipeline CI/CD (Environment production do repo do serviço) ---
# CI_DISCORD_WEBHOOK=   # ou DISCORD_WEBHOOK_URL da base oracle-infra
# VPS_HOST=
# VPS_USER=
# VPS_SSH_PRIVATE_KEY=
# VPS_SSH_HOST_KEY=
# VPS_SSH_PORT=

# --- Infra container (Compose futuro) ---
# TZ=America/Campo_Grande
# NODE_ENV=production
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
