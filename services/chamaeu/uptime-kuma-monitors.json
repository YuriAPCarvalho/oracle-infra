{
  "version": "1",
  "monitors": [
    {
      "name": "chamaeu-api-health",
      "type": "http",
      "url": "https://api.chamaeu.app/health",
      "interval": 60,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299"]
    },
    {
      "name": "chamaeu-web",
      "type": "http",
      "url": "https://chamaeu.app",
      "interval": 120,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299"]
    },
    {
      "name": "chamaeu-adm",
      "type": "http",
      "url": "https://adm.chamaeu.app",
      "interval": 120,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299"]
    }
  ]
}
