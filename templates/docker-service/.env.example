# Copy to .env on the VPS after the real service requirements are known.
# Never commit .env.

# Required by compose.yml
# SERVICE_NAME=
# SERVICE_IMAGE=

# Optional, only when Traefik or an internal HTTP check is needed
# SERVICE_HOST=
# SERVICE_PORT=

# Optional application settings
# TZ=America/Campo_Grande

# Define real variables only after reviewing the application repository.
# APP_TOKEN=
# DATABASE_URL=
